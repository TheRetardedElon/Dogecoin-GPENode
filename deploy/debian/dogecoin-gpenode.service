# dogecoin-gpenode — headless Core Pro / GPENode (package install)
# Paths:
#   /usr/bin/dogecoind
#   /etc/dogecoin-gpenode/dogecoin.conf
#   /var/lib/dogecoin-gpenode

[Unit]
Description=Dogecoin GPENode (Core Pro headless)
Documentation=https://github.com/TheRetardedElon/Dogecoin-GPENode
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=dogecoin
Group=dogecoin
# Bundled Boost/etc when present (headless release layout)
Environment=LD_LIBRARY_PATH=/usr/lib/dogecoin-gpenode
ExecStart=/usr/bin/dogecoind -conf=/etc/dogecoin-gpenode/dogecoin.conf -datadir=/var/lib/dogecoin-gpenode
KillSignal=SIGINT
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
TimeoutStartSec=30

# Reasonable hardening without the ultra-restrictive bind mounts
# (those can break dynamic linking / DNS on some hosts).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=true
MemoryDenyWriteExecute=false
# Optional cap (override with drop-in if you need more RAM for settlement)
# MemoryMax=4G

[Install]
WantedBy=multi-user.target
