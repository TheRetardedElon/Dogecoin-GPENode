[Unit]
Description=Schedule Dogecoin UTXO snapshot dump (GPENode)
Requires=dogecoin-snapshot.service

[Timer]
# Daily 06:15 UTC — low-traffic window; RandomizedDelay spreads load
OnCalendar=*-*-* 06:15:00 UTC
Persistent=true
RandomizedDelaySec=600
Unit=dogecoin-snapshot.service

[Install]
WantedBy=timers.target
